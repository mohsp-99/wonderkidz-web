#!/usr/bin/env bash
# WonderKidz dev runner. Usage: scripts/wk <command>
#   setup     create .venv, install deps, create .env, migrate, seed (safe to re-run)
#   start     run the dev server in the background (PID + log under .run/)
#   stop      stop the background server
#   restart   stop + start
#   status    is it running? on which port?
#   logs      tail the server log
#   fg        run the server in the foreground (Ctrl+C to stop)
#   test      run ruff, the migrations check and the test suite
#   seed      (re)seed demo data; pass --flush to wipe listings/users first
#   shell     Django shell
#   manage    any manage.py command, e.g. scripts/wk manage createsuperuser
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
VENV=".venv"
PY="$VENV/bin/python"
RUN_DIR=".run"
PID_FILE="$RUN_DIR/server.pid"
LOG_FILE="$RUN_DIR/server.log"
HOST="${WK_HOST:-0.0.0.0}"
PORT="${WK_PORT:-8000}"
PIP_INDEX="${WK_PIP_INDEX:-https://pypi.org/simple}"

say()  { printf '\033[1;36m▸ %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m! %s\033[0m\n' "$*" >&2; }
die()  { printf '\033[1;31m✗ %s\033[0m\n' "$*" >&2; exit 1; }

need_venv() { [ -x "$PY" ] || die "no virtualenv — run: scripts/wk setup"; }

is_running() {
  [ -f "$PID_FILE" ] || return 1
  local pid; pid="$(cat "$PID_FILE")"
  kill -0 "$pid" 2>/dev/null
}

port_busy() { (exec 3<>"/dev/tcp/127.0.0.1/$PORT") 2>/dev/null; }

# PIDs of any dev server bound to our port, found via /proc (no pgrep pattern games).
server_pids() {
  local pid cmd
  for pid in $(ls /proc | grep -E '^[0-9]+$'); do
    [ -r "/proc/$pid/cmdline" ] || continue
    cmd="$( { tr '\0' ' ' <"/proc/$pid/cmdline"; } 2>/dev/null || true)"
    case "$cmd" in
      *manage.py\ runserver*":$PORT"*) echo "$pid" ;;
    esac
  done
}

cmd_setup() {
  if [ ! -x "$PY" ]; then say "creating virtualenv"; python3 -m venv "$VENV"; fi
  say "installing dependencies"
  # The machine's pip mirror is missing some wheels; fall back to pypi.org explicitly.
  "$VENV/bin/pip" install -q --upgrade pip
  "$VENV/bin/pip" install -q -r requirements.txt || "$VENV/bin/pip" install -q -i "$PIP_INDEX" -r requirements.txt
  "$VENV/bin/pip" install -q ruff || "$VENV/bin/pip" install -q -i "$PIP_INDEX" ruff || true
  if [ ! -f .env ]; then say "creating .env from .env.example"; cp .env.example .env; fi
  say "migrating"
  "$PY" manage.py migrate --noinput
  if [ "$("$PY" manage.py shell -c 'from apps.listings.models import Listing; print(Listing.objects.count())' 2>/dev/null)" = "0" ]; then
    say "seeding demo data (first run)"
    "$PY" manage.py seed_demo
  fi
  say "setup complete — start with: scripts/wk start"
}

cmd_start() {
  need_venv
  mkdir -p "$RUN_DIR"
  if is_running; then say "already running (pid $(cat "$PID_FILE")) at http://localhost:$PORT"; return 0; fi
  rm -f "$PID_FILE"
  if port_busy; then die "port $PORT is in use by another process (set WK_PORT to use a different one)"; fi
  "$PY" manage.py check >/dev/null
  "$PY" manage.py migrate --noinput --check >/dev/null 2>&1 || { say "applying pending migrations"; "$PY" manage.py migrate --noinput; }
  say "starting dev server on http://localhost:$PORT (log: $LOG_FILE)"
  # setsid + full fd detachment so the server survives the shell that started it.
  setsid "$PY" manage.py runserver "$HOST:$PORT" --noreload </dev/null >>"$LOG_FILE" 2>&1 &
  echo $! >"$PID_FILE"
  for _ in $(seq 1 40); do
    if curl -fs -o /dev/null "http://127.0.0.1:$PORT/"; then
      say "up ✓  login with any phone, OTP $(grep -E '^OTP_DEV_CODE=' .env | cut -d= -f2)"; return 0
    fi
    is_running || { warn "server exited; last log lines:"; tail -20 "$LOG_FILE"; exit 1; }
    sleep 0.5
  done
  warn "server started but did not answer within 20s; check: scripts/wk logs"
}

cmd_stop() {
  local pids
  pids="$( { is_running && cat "$PID_FILE"; server_pids; } | sort -u | tr '\n' ' ')"
  if [ -z "${pids// /}" ]; then say "not running"; rm -f "$PID_FILE"; return 0; fi
  say "stopping: $pids"
  for pid in $pids; do kill "$pid" 2>/dev/null || true; done
  for _ in $(seq 1 20); do
    local alive=0
    for pid in $pids; do kill -0 "$pid" 2>/dev/null && alive=1; done
    [ "$alive" = 0 ] && break
    sleep 0.25
  done
  for pid in $pids; do kill -9 "$pid" 2>/dev/null || true; done
  rm -f "$PID_FILE"
  say "stopped"
}

cmd_status() {
  if is_running; then say "running (pid $(cat "$PID_FILE")) at http://localhost:$PORT"; else say "not running"; fi
  if port_busy; then say "port $PORT is answering"; fi
}

cmd_logs() { mkdir -p "$RUN_DIR"; touch "$LOG_FILE"; tail -n "${1:-50}" -f "$LOG_FILE"; }

cmd_fg() { need_venv; "$PY" manage.py runserver "$HOST:$PORT"; }

cmd_test() {
  need_venv
  if [ -x "$VENV/bin/ruff" ]; then say "ruff"; "$VENV/bin/ruff" check .; fi
  say "migrations check"; "$PY" manage.py makemigrations --check --dry-run
  say "tests"; "$PY" manage.py test --noinput "$@"
}

cmd_seed()   { need_venv; "$PY" manage.py seed_demo "$@"; }
cmd_shell()  { need_venv; "$PY" manage.py shell "$@"; }
cmd_manage() { need_venv; "$PY" manage.py "$@"; }

case "${1:-}" in
  setup)   shift; cmd_setup "$@" ;;
  start)   shift; cmd_start "$@" ;;
  stop)    shift; cmd_stop "$@" ;;
  restart) shift; cmd_stop; cmd_start ;;
  status)  shift; cmd_status ;;
  logs)    shift; cmd_logs "$@" ;;
  fg)      shift; cmd_fg ;;
  test)    shift; cmd_test "$@" ;;
  seed)    shift; cmd_seed "$@" ;;
  shell)   shift; cmd_shell "$@" ;;
  manage)  shift; cmd_manage "$@" ;;
  *) sed -n '2,14p' "$0"; exit 1 ;;
esac
