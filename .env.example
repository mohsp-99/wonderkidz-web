# Copy to .env for local development. All values optional; defaults run on SQLite with console OTP.
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000
# DATABASE_URL=postgres://wonderkidz:wonderkidz@localhost:5432/wonderkidz
# REDIS_URL=redis://localhost:6379/0
# Container hosts with a mounted disk and no Postgres/S3: keep db.sqlite3 and media/ under this directory
# DATA_DIR=/data
# Demo hosts without object storage / a front web server: let Django serve media/ (defaults to DEBUG)
# SERVE_MEDIA=true
# Container start (scripts/start.sh): seed demo content when the listings table is empty
# SEED_DEMO_ON_START=true

# SMS / OTP (plug-and-play): console | kavenegar | smsir
SMS_BACKEND=console
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=wonderkidz-otp
SMSIR_API_KEY=
SMSIR_OTP_TEMPLATE_ID=0
# Dev convenience: a code that always verifies (leave empty in production)
OTP_DEV_CODE=12345

# Payments (plug-and-play): fake | zarinpal | idpay
PAYMENT_GATEWAY=fake
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
IDPAY_API_KEY=
IDPAY_SANDBOX=true

# Object storage (Arvan / S3-compatible). Leave empty to store media on local disk.
S3_BUCKET=
S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

MODERATION_MODEL=ai_first
LISTING_TTL_DAYS=30
NEW_ACCOUNT_LISTING_CAP=5
